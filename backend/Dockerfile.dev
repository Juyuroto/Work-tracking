FROM python:3.14.10-alpine3.24
RUN apk add --no-cache tzdata && adduser -D -u 1000 app && mkdir /data && chown app:app /data
ENV DB_PATH=/data/work-tracking.db TZ=Europe/Paris PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
USER app
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
